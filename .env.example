# Copy to .env for local development. Replace placeholders; never commit secrets.
NODE_ENV=development
PORT=3000
TRUST_PROXY=
ORION_DB_PATH=./orion.db
CORS_ORIGINS=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# AI Assistant API key (Gemini / LLM)
gemini_api_key=
LLM_API_KEY=
